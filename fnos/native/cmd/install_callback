#!/bin/bash
#
# Octop 本地版 — 安装后回调
#
# 单人自托管没有账号：安装向导不收集用户名/密码，这里只准备 PKGVAR/.env
# （端口/日志/数据路径）、平台权限（octop-native 免密码 sudo）、官方 CLI
# 入口，并做一次预初始化。账号由首次启动的服务自动绑定，不再写凭据文件。
#
set -euo pipefail

# 共享函数库（find_python312 / fix_ownership_and_perms / free_octop_ports /
# happyclaw_render_config_wizard 等）
# 打包时由 scripts/build-fpk.sh 注入；仓库内运行无此文件时跳过（函数缺失时再报错）。
_HAPPYCLAW_COMMON="$(dirname "$0")/common.sh"
[ -f "$_HAPPYCLAW_COMMON" ] || _HAPPYCLAW_COMMON="/var/apps/octop-native/cmd/common.sh"
[ -f "$_HAPPYCLAW_COMMON" ] && source "$_HAPPYCLAW_COMMON"

# 释放 Octop 端口（8088=Docker 版，8089=本地版），杀掉残留/孤儿进程，避免重装端口冲突。
free_octop_ports

PKGVAR="${TRIM_PKGVAR:-/var/apps/octop-native/var}"
APPDEST="${TRIM_APPDEST:-/var/apps/octop-native}"
mkdir -p "$PKGVAR"
ENV_FILE="$PKGVAR/.env"

# 数据落在 FnOS 的 data-share 共享目录，升级时保留。
if [ -n "${TRIM_DATA_SHARE_PATHS:-}" ]; then
    DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
else
    DATA_DIR="${APPDEST}/shares/octop-native/data"
fi
mkdir -p "$DATA_DIR"

fail_install() {
    echo "[octop-native] $1" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
    echo "[octop-native] $1" >&2 || true
    exit 1
}

if type happyclaw_assert_native_arch >/dev/null 2>&1; then
    if ! REASON="$(happyclaw_assert_native_arch)"; then
        fail_install "$REASON"
    fi
fi

{
    echo "HAPPYCLAW_PORT=8089"
    echo "HAPPYCLAW_BIND_HOST=0.0.0.0"
    echo "HAPPYCLAW_LOG_LEVEL=info"
} > "$ENV_FILE"

chmod 600 "$ENV_FILE"
echo "[octop-native] 已写入配置: $ENV_FILE" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true

# ---------------------------------------------------------------------------
# 渲染「设置」窗口（只显示数据目录与配置入口，没有密码表单）
# ---------------------------------------------------------------------------
WIZARD_TEMPLATE="$APPDEST/wizard/config.template"
WIZARD_DIR="$(dirname "$APPDEST")/wizard"
[ -f "$WIZARD_TEMPLATE" ] || WIZARD_TEMPLATE="${APPDEST}/../wizard/config"
happyclaw_render_config_wizard "$WIZARD_TEMPLATE" "$WIZARD_DIR" "$DATA_DIR"

# ---------------------------------------------------------------------------
# 修正属主/权限：.env 与 appdata 改回 octop-native，避免服务以 octop-native 启动
# 时 . "$PKGVAR/.env" 报 Permission denied（root 写 root 属主，低权限用户读不了）。
# ---------------------------------------------------------------------------
fix_ownership_and_perms "$PKGVAR" "$ENV_FILE"

# 校验 Python 3.12 是否存在
if ! PY="$(find_python312)"; then
    echo "[octop-native] 错误：飞牛系统中未找到 Python 3.12。" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
    echo "请先前往飞牛应用中心 → 开发工具 → 安装「Python 3.12」，然后重新安装 Octop 本地版。" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
    exit 1
fi

echo "[octop-native] 已检测到 Python 3.12: $PY" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true

# ---------------------------------------------------------------------------
# 授予 octop-native 免密码 sudo（NOPASSWD）。
# Octop 的远程桌面/浏览器等组件在运行时会以 octop-native 身份执行
# `sudo -n ...`（例如 desktop/setup.py 的 install/start/resize/uninstall），
# 若 sudo 需要密码就会失败报 “a password is required”。
# 这里在安装回调（root 权限）阶段一次性配好，之后用户在界面里安装
# 远程桌面 / 在工作台终端里执行 sudo 都不再需要输入密码。
# ---------------------------------------------------------------------------
HAPPYCLAW_USER="octop-native"
SUDOERS_FILE="/etc/sudoers.d/octop-native"
cat > "$SUDOERS_FILE" <<'EOF'
# 允许 octop-native 免密码执行任意命令（Octop 远程桌面/浏览器/工作台终端需要）
# !requiretty：Octop 以内嵌子进程方式调用 `sudo -n ...`，没有 controlling tty；
# 若系统 sudoers 默认开启 requiretty，这里必须显式关闭，否则会报
# "sorry, you must have a tty to run sudo" 而让远程桌面/浏览器安装失败。
Defaults:octop-native !requiretty
octop-native ALL=(ALL) NOPASSWD: ALL
EOF
chmod 0440 "$SUDOERS_FILE"
if command -v visudo >/dev/null 2>&1; then
    if ! visudo -c -f "$SUDOERS_FILE" >/dev/null 2>&1; then
        echo "[octop-native] 错误：写入的 sudoers 语法校验失败，请检查 ${SUDOERS_FILE}" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
        exit 1
    fi
fi
echo "[octop-native] 已配置 ${HAPPYCLAW_USER} 免密码 sudo" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true

# ---------------------------------------------------------------------------
# 锁定系统账户 octop-native：它只是包内服务身份，不提供登录。
# 显式锁定，而不是设随机密码——随机密码看起来像能登录，实际没人记得，
# 还会诱使后来的人把它抄进某个文件。免密码 sudo 走 NOPASSWD，不受影响。
# ---------------------------------------------------------------------------
if id "$HAPPYCLAW_USER" >/dev/null 2>&1; then
    if passwd -l "$HAPPYCLAW_USER" >/dev/null 2>&1; then
        echo "[octop-native] 已锁定系统账户 ${HAPPYCLAW_USER}（仅作包内服务身份，不能登录）" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
    else
        echo "[octop-native] 警告：无法锁定系统账户 ${HAPPYCLAW_USER}，请手动执行 passwd -l ${HAPPYCLAW_USER}" >&2 || true
    fi
fi

# ---------------------------------------------------------------------------
# 将官方 octop CLI 暴露到 PATH，让用户安装后像官方一样直接用 `octop` 命令
# （例如 `octop --help` / `octop provider list` / `octop agent list` /
#   `octop skills ...` / `octop backup ...`）。真正的服务由飞牛应用中心托管
# （cmd/main 拉起 bin/octop），本 CLI 仅作命令行入口。
# 并做一次冒烟验证：CLI 能真实执行并输出版本号才算注册成功。
# ---------------------------------------------------------------------------
LAUNCHER="$APPDEST/bin/octop"
chmod +x "$LAUNCHER" 2>/dev/null || true

CLI_SRC="$APPDEST/bin/octop-cli"
if [ -f "$CLI_SRC" ]; then
    chmod +x "$CLI_SRC" 2>/dev/null || true
    ln -sf "$CLI_SRC" /usr/local/bin/octop-cli
    ln -sf "$CLI_SRC" /usr/local/bin/octop
    echo "[octop-native] 已注册命令：octop / octop-cli -> $CLI_SRC" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
    # CLI 冒烟验证（不阻塞安装：失败只告警，首次启动后仍可用）
    if "$CLI_SRC" version >/dev/null 2>&1; then
        echo "[octop-native] CLI 冒烟验证通过：octop version 可正常执行" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
    else
        echo "[octop-native] 警告：CLI 冒烟验证未通过（octop version 执行失败）；首次启动会自动用内置 whl 离线安装，之后 CLI 即可用。" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
    fi
fi

# 安装阶段先做环境初始化，避免应用中心 start 在 30 秒内超时、只显示「启动失败」。
if [ -f "$LAUNCHER" ]; then
    echo "[octop-native] 安装后预初始化 ..." >> "$PKGVAR/info.log"
    prepare_rc=0
    if id "$HAPPYCLAW_USER" >/dev/null 2>&1 && command -v runuser >/dev/null 2>&1; then
        runuser -u "$HAPPYCLAW_USER" -- "$LAUNCHER" --prepare >> "$PKGVAR/info.log" 2>&1 || prepare_rc=$?
    else
        "$LAUNCHER" --prepare >> "$PKGVAR/info.log" 2>&1 || prepare_rc=$?
    fi
    if [ "$prepare_rc" != 0 ]; then
        fail_install "首次初始化失败（退出码 ${prepare_rc}）。请查看应用日志 var/info.log，或确认已安装「Python 3.12」。"
    fi
    echo "[octop-native] 预初始化完成" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
fi

exit 0
