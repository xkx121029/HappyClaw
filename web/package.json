{
  "name": "happyclaw-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "prettier --check .",
    "api:gen": "openapi-typescript openapi/octop.openapi.json -o src/lib/api/schema.gen.ts",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "clsx": "^2.1.1",
    "i18next": "^27.2.2",
    "lucide-react": "^1.77.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "tailwind-merge": "^3.7.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^3.2.6"
  }
}
