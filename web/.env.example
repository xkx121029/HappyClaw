# Origin of the Python backend during `npm run dev`.
# The Vite dev server proxies /api here; leave empty to use the proxy default.
HAPPYCLAW_API_ORIGIN=http://127.0.0.1:8080

# Build-time SPA configuration (inlined by Vite, so no secrets here).
# VITE_API_BASE=            # set only for a cross-origin deployment
# VITE_APP_VERSION=0.2.0-dev
# VITE_USE_MOCK_API=0       # 1 forces sample data even when a backend answers
